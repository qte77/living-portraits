{
  "permissions": {
    "deny": [
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add . *)",
      "Bash(git commit -a *)",
      "Bash(git commit --all *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release create *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Edit(./.claude/hooks/**)",
      "Write(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)"
    ],
    "allow": [
      "Bash(python -m pytest *)",
      "Bash(python tests/run_all.py *)",
      "Bash(python runtime/video_graph.py build *)",
      "Bash(python scripts/seed_demo_media.py *)",
      "Bash(python scripts/export_context_view.py *)",
      "Bash(python runtime/capture_demo.py --selftest *)",
      "Bash(ruff check *)",
      "Bash(ruff format --diff *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote -v)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-upstream.sh",
            "args": [],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-destructive-flags.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
